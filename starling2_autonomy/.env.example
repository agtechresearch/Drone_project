# 이 파일을 `.env.local` 로 복사한 뒤 본인 환경값을 채운다.
#   cp .env.example .env.local
# `.env.local` 은 .gitignore 처리되어 커밋되지 않는다.

# SSH 대상. ~/.ssh/config 에 정의한 alias 를 쓰는 것을 권장한다
# (IP 를 직접 적는 것보다 네트워크가 바뀌어도 스크립트를 안 고쳐도 된다).
DRONE_HOST=Starling2_AgtechLab

# 기체에서 비행 코드가 놓이는 디렉토리
DRONE_DIR=/home/root

# 참고: ~/.ssh/config 예시
#   Host Starling2_AgtechLab
#       HostName <기체 IP>
#       User root
#       IdentityFile ~/.ssh/id_ed25519
