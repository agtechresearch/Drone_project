# Starling 2 SITL 개발 환경 (새 Gazebo)
# Base: Ubuntu 22.04 + PX4 v1.15 + Gazebo Harmonic (gz-sim8) + ROS2 Humble
# Classic 11 기반 Dockerfile을 Harmonic으로 교체한 버전. GUI는 X11 forwarding / VirtualGL(호스트 /tmp/vgl_tvnc_pkgs 마운트)로 지원.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV TZ=Asia/Seoul

RUN apt-get update && apt-get install -y --no-install-recommends \
    locales tzdata curl wget gnupg2 lsb-release ca-certificates \
    software-properties-common sudo git vim nano \
    build-essential cmake ninja-build ccache \
    python3 python3-pip python3-dev \
    && locale-gen en_US.UTF-8 \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && rm -rf /var/lib/apt/lists/*

# Gazebo Harmonic (OSRF 저장소) - gz-harmonic 메타패키지는 런타임 + -dev 라이브러리 포함
RUN wget -qO - https://packages.osrfoundation.org/gazebo.gpg | \
    gpg --dearmor -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    gz-harmonic \
    && rm -rf /var/lib/apt/lists/*

# ROS2 Humble (ros-base만; gazebo-ros-pkgs 제외)
RUN add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-base ros-humble-rmw-fastrtps-cpp \
    python3-colcon-common-extensions python3-rosdep python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*
RUN rosdep init && rosdep update

# PX4 필수 의존성 (Tools/setup/ubuntu.sh 참고)
RUN apt-get update && apt-get install -y --no-install-recommends \
    astyle bzip2 dirmngr file gdb genromfs gcc-arm-none-eabi gperf lcov \
    libncurses5-dev libtool net-tools patch pkg-config \
    python3-setuptools python3-wheel rsync shellcheck unzip xz-utils zip \
    protobuf-compiler libeigen3-dev libopencv-dev libgstreamer-plugins-base1.0-dev \
    xvfb x11-apps mesa-utils libgl1-mesa-glx libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    argcomplete argparse cerberus coverage empy==3.3.4 jinja2 \
    matplotlib numpy nunavut packaging pandas pkgconfig \
    pyros-genmsg pyserial "pyulog>=0.5.0" pyyaml requests setuptools \
    six toml wheel jsonschema psutil pymavlink kconfiglib future lxml==4.9.4 \
    && pip3 install --no-cache-dir mavsdk==0.12.0
# tag detector of v3_marker/scripts/tag_detect.py (2026-11-01, codex tag-detector-image-dependency): it was installed by hand with
# "pip install --user" in the starling-gz container on 2026-10-29 (worklog/2026-10-29.md) and is kept only in the committed image
# starling-sitl-gz:20261101-preinit; the version below is the one found there (pip show: 1.0.4.post11, requires numpy).
# Not yet verified by a clean build (user decision 2026-11-01: Dockerfile only).
RUN pip3 install --no-cache-dir pupil-apriltags==1.0.4.post11

ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=dronesim
RUN groupadd --gid ${USER_GID} ${USERNAME} && \
    useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} -s /bin/bash && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}
RUN echo "source /opt/ros/humble/setup.bash" >> /home/${USERNAME}/.bashrc && \
    chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.bashrc

USER ${USERNAME}
WORKDIR /home/${USERNAME}
CMD ["/bin/bash"]
